# Copy to .env. Everything has a default; these are the ones you will want to set.

# port (hosts such as Railway and Render set PORT themselves)
STAFF_PORT=5182

# where the app's own database lives (tabs, rounds, waiter calls, waiter accounts): created on first start
# TABS_DB=./data/tabs.sqlite3

# Stock Management's database: the menu, recipes and stock the kitchen screen reads and updates.
# Point this at the SQLite file of the Stock Management app (it is shared, not copied).
# INVENTORY_DB=/path/to/Stock Management/server/db/vasamo.sqlite3
# INVENTORY_DIR=../Stock Management/server

# the restaurant's name on the screens and e-receipts
RESTAURANT_NAME=Oasys Restaurant
